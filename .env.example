# ==============================================================================
# ALUGARA - STANDALONE AUTOMATED TRADING ENGINE
# ==============================================================================

# Server & Service Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Stockbit Authentication & PIN
STOCKBIT_USERNAME=your_stockbit_username
STOCKBIT_PASSWORD=your_stockbit_password
STOCKBIT_TRADING_PIN=123456
STOCKBIT_SESSION_DIR=./sessions

# Browser Automation (Headless mode for Linux Server)
HEADLESS_MODE=true
BROWSER_TIMEOUT_MS=30000

# Telegram Bot Notification
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Market Trading Schedule (WIB - Asia/Jakarta)
MARKET_TIMEZONE=Asia/Jakarta
MARKET_BUY_HOUR=15
MARKET_BUY_MINUTE=40
MARKET_SELL_HOUR=9
MARKET_SELL_MINUTE=10

# Capital & Risk Allocation per Strategy
CAPITAL_PER_STRATEGY=9000000
MAX_SLIPPAGE_PERCENT=2.0
AUTO_EXECUTE_ENABLED=true
